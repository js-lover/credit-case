{
  "info": {
    "name": "CreditCase API",
    "description": "Digital Loan & Repayment Management System — Sunum Senaryoları\n\n⚠️  Enum değerleri integer olarak gönderilir:\n  LoanType       → Personal=0, Education=1, Vehicle=2\n  ProfessionCategory → Government=0, Healthcare=1, Finance=2, Technology=3, Education=4, Commerce=5, Services=6\n  EmploymentStatus   → Active=0, PartTime=1, Freelance=2, Retired=3, Unemployed=4\n\n⚠️  ID'ler veritabanı seed'ine göre değişir. Değişkenler güncel seed verisiyle ayarlıdır.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",              "value": "http://localhost:5285" },
    { "key": "customerId_mustafa",   "value": "29",  "description": "Mustafa Koç — Güvenli ~1650" },
    { "key": "customerId_nur",       "value": "34",  "description": "Nur Şahin — GelişimeAçık ~1005 (red senaryosu)" },
    { "key": "customerId_ayse",      "value": "33",  "description": "Ayşe Kara — Dengeli ~1375" },
    { "key": "customerId_zeynep",    "value": "36",  "description": "Zeynep Demir — yeni oluşturulan demo müşteri" },
    { "key": "loanId_standard",      "value": "24",  "description": "Zeynep standart kredi (Personal 120K 12ay)" },
    { "key": "loanId_balloon",       "value": "25",  "description": "Zeynep balon kredi (Vehicle 100K 12ay)" },
    { "key": "loanId_mustafa",       "value": "19",  "description": "Mustafa araç kredisi 450K 36ay" },
    { "key": "installmentId_overdue","value": "588", "description": "Mustafa loan:19 #6 — Overdue, ödeme demosu için" },
    { "key": "evaluationId",         "value": "340", "description": "Zeynep onaylı değerlendirme" }
  ],
  "item": [

    {
      "name": "1 — Müşteri İşlemleri",
      "item": [

        {
          "name": "Tüm Müşterileri Getir",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            },
            "description": "→ 200 OK | 7 müşteri listelenir (seed sonrası)"
          }
        },

        {
          "name": "Müşteri Detayı — Mustafa Koç",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customerId_mustafa}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "{{customerId_mustafa}}"]
            },
            "description": "→ 200 OK | professionCategory:0 (Government), employmentStatus:0 (Active)"
          }
        },

        {
          "name": "Borç Özeti — Mustafa Koç",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customerId_mustafa}}/summary",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "{{customerId_mustafa}}", "summary"]
            },
            "description": "→ 200 OK | totalRemainingPrincipal, overdueCount, paidCount, pendingCount, totalOutstandingDebt"
          }
        },

        {
          "name": "Değerlendirme Geçmişi — Ayşe Kara",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customerId_ayse}}/evaluations",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "{{customerId_ayse}}", "evaluations"]
            },
            "description": "→ 200 OK | isApproved:false kayıtları döner (seed'de reddedildi)"
          }
        },

        {
          "name": "Yeni Müşteri Oluştur",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Ahmet\",\n  \"lastName\": \"Yılmaz\",\n  \"identityNumber\": \"88888888801\",\n  \"email\": \"ahmet.yilmaz@creditcase.dev\",\n  \"phoneNumber\": \"5321234999\",\n  \"dateOfBirth\": \"1988-07-20T00:00:00Z\",\n  \"monthlyIncome\": 45000,\n  \"professionCategory\": 3,\n  \"employmentStatus\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            },
            "description": "→ 201 Created\nprofessionCategory:3 = Technology\nemploymentStatus:0 = Active\nDönen id'yi loanId oluşturma adımlarında kullan."
          }
        },

        {
          "name": "Müşteri Güncelle — Zeynep",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Zeynep\",\n  \"lastName\": \"Demir\",\n  \"email\": \"zeynep.demir.new@creditcase.dev\",\n  \"phoneNumber\": \"5321234568\",\n  \"dateOfBirth\": \"1990-04-10T00:00:00Z\",\n  \"monthlyIncome\": 40000,\n  \"professionCategory\": 3,\n  \"employmentStatus\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers/{{customerId_zeynep}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "{{customerId_zeynep}}"]
            },
            "description": "→ 200 OK | Tüm alanlar (email, gelir, meslek vb.) güncellenebilir."
          }
        }

      ]
    },

    {
      "name": "2 — Kredi Değerlendirme",
      "item": [

        {
          "name": "Başvuru Değerlendir — ONAYLANDI (Mustafa)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 29,\n  \"loanType\": 0,\n  \"requestedAmount\": 400000,\n  \"requestedTerm\": 24\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans/evaluate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "evaluate"]
            },
            "description": "→ 200 OK | isApproved:true | creditScore:~1650 | riskLevel:0 (Low)\nloanType:0 = Personal"
          }
        },

        {
          "name": "Başvuru Değerlendir — REDDEDİLDİ (Nur Şahin)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 34,\n  \"loanType\": 0,\n  \"requestedAmount\": 150000,\n  \"requestedTerm\": 24\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans/evaluate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "evaluate"]
            },
            "description": "→ 200 OK | isApproved:false | rejectionReason dolu döner\nNur Şahin: düşük gelir (7.500 ₺), part-time çalışan → minimum taksit sınırı aşılamıyor."
          }
        },

        {
          "name": "Değerlendirme Detayı",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/evaluation/{{evaluationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "evaluation", "{{evaluationId}}"]
            },
            "description": "→ 200 OK | Daha önce yapılmış bir değerlendirme kaydı getirir."
          }
        },

        {
          "name": "Maksimum Kredi Uygunluğu — Mustafa",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/maximum-eligibility/{{customerId_mustafa}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "maximum-eligibility", "{{customerId_mustafa}}"]
            },
            "description": "→ 200 OK | maximumAmount ve maximumTerm döner. Başvuru yapmadan ön bilgi."
          }
        }

      ]
    },

    {
      "name": "3 — Kredi İşlemleri",
      "item": [

        {
          "name": "Tüm Kredileri Getir",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans"]
            },
            "description": "→ 200 OK | loanType:0=Personal, 1=Education, 2=Vehicle | status:0=Active"
          }
        },

        {
          "name": "Kredi Detayı — Mustafa Araç",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId_mustafa}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "{{loanId_mustafa}}"]
            },
            "description": "→ 200 OK | installments dizisi taksit planını içerir. Ödenmiş taksitler status:0, vadesi geçmiş status:2."
          }
        },

        {
          "name": "Balon Kredi Detayı — Zeynep",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId_balloon}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "{{loanId_balloon}}"]
            },
            "description": "→ 200 OK | Son taksit (ID:762) isBalloon:true ve tutar diğerlerinden (~5.985 vs ~53.862 ₺) çok yüksek."
          }
        },

        {
          "name": "Standart Kredi Oluştur",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 29,\n  \"loanType\": 0,\n  \"principalAmount\": 150000,\n  \"term\": 12,\n  \"startDate\": \"2026-05-12T00:00:00Z\",\n  \"isBalloonPayment\": false\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans"]
            },
            "description": "→ 201 Created | rateAmount sistem tarafından hesaplanır (UI'dan girilemez).\n12 eşit tutarlı taksit üretilir, hepsi isBalloon:false."
          }
        },

        {
          "name": "Balon Ödemeli Kredi Oluştur",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 29,\n  \"loanType\": 2,\n  \"principalAmount\": 100000,\n  \"term\": 12,\n  \"startDate\": \"2026-05-12T00:00:00Z\",\n  \"isBalloonPayment\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans"]
            },
            "description": "→ 201 Created | loanType:2 = Vehicle (zorunlu)\nTaksit 1–11: ~5.985 ₺ | Taksit 12 (isBalloon:true): ~53.862 ₺\nKural: yalnızca Vehicle, skor ≥ 1150, vade ≤ 36 ay."
          }
        }

      ]
    },

    {
      "name": "4 — Taksit & Ödeme",
      "item": [

        {
          "name": "Tüm Taksitleri Getir",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/installments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "installments"]
            },
            "description": "→ 200 OK | Bu çağrıda vadesi geçmiş Unpaid taksitler otomatik Overdue'ye çekilir.\nstatus: 0=Paid, 1=Unpaid, 2=Overdue"
          }
        },

        {
          "name": "Taksit Detayı — Mustafa #6 (Overdue)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/installments/{{installmentId_overdue}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "installments", "{{installmentId_overdue}}"]
            },
            "description": "→ 200 OK | status:2 (Overdue) | payment alanı null (henüz ödenmedi)"
          }
        },

        {
          "name": "Tüm Ödemeleri Getir",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"]
            },
            "description": "→ 200 OK | customerFullName, paymentDate, paymentAmount, loanType alanları döner."
          }
        },

        {
          "name": "Taksit Öde — Mustafa #6",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"installmentId\": 588,\n  \"paymentAmount\": 21094.28\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"]
            },
            "description": "→ 201 Created | Taksit status:2→0 (Overdue→Paid)\nArdından GET /api/loans/19 ile RemainingPrincipal'in düştüğünü gözlemle.\nSıralı ödeme kuralı: önceki taksitler ödenmiş olmalıdır."
          }
        },

        {
          "name": "Ödeme Sonrası Kredi Durumu",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/loans/{{loanId_mustafa}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "{{loanId_mustafa}}"]
            },
            "description": "→ 200 OK | Ödeme sonrası RemainingPrincipal'in güncellendiğini ve #6 taksitin status:0 (Paid) olduğunu doğrula."
          }
        }

      ]
    },

    {
      "name": "5 — Hata Senaryoları",
      "item": [

        {
          "name": "404 — Olmayan Müşteri",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/customers/9999",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers", "9999"]
            },
            "description": "→ 404 Not Found\n{ \"type\": \"NotFound\", \"message\": \"9999 numaralı müşteri bulunamadı.\" }"
          }
        },

        {
          "name": "400 — Validasyon Hatası (çoklu alan)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"\",\n  \"lastName\": \"\",\n  \"identityNumber\": \"abc\",\n  \"email\": \"gecersiz-email\",\n  \"phoneNumber\": \"123\",\n  \"dateOfBirth\": \"2020-01-01T00:00:00Z\",\n  \"monthlyIncome\": -1,\n  \"professionCategory\": 3,\n  \"employmentStatus\": 0\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/customers",
              "host": ["{{baseUrl}}"],
              "path": ["api", "customers"]
            },
            "description": "→ 400 Bad Request\nFirstName, LastName, IdentityNumber, Email, PhoneNumber, DateOfBirth, MonthlyIncome hataları tek yanıtta gelir."
          }
        },

        {
          "name": "422 — Zaten Ödenmiş Taksit",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"installmentId\": 583,\n  \"paymentAmount\": 21094.28\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments"]
            },
            "description": "→ 422 Unprocessable Entity\nInstallment 583 = Mustafa #1, zaten ödenmiş.\n{ \"type\": \"BusinessRuleViolation\", \"message\": \"Bu taksit zaten ödenmiştir.\" }"
          }
        },

        {
          "name": "400 — Balon + Araç Dışı Kredi",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 29,\n  \"loanType\": 0,\n  \"principalAmount\": 100000,\n  \"term\": 12,\n  \"startDate\": \"2026-05-12T00:00:00Z\",\n  \"isBalloonPayment\": true\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans"]
            },
            "description": "→ 400 Bad Request\nloanType:0 = Personal — balon ödeme sadece loanType:2 (Vehicle) ile kullanılabilir."
          }
        },

        {
          "name": "422 — Kredi Skoru Yetersiz (Değerlendirme)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerId\": 34,\n  \"loanType\": 0,\n  \"requestedAmount\": 500000,\n  \"requestedTerm\": 24\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/api/loans/evaluate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "loans", "evaluate"]
            },
            "description": "→ 200 OK ama isApproved:false\nNur Şahin 500.000 ₺ talep ediyor; skor ~1005 (GelişimeAçık) ile talep tutarı maksimum limiti (gelir×3 = 22.500 ₺) çok aşıyor."
          }
        }

      ]
    }

  ]
}
